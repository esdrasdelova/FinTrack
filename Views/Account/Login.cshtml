@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Entrar";
}
<div class="auth-form fade-up">
    <div class="mb-4">
        <h2>Bem-vindo de volta</h2>
        <p class="text-muted" style="font-size:13px">Entre com sua conta para acessar seu painel financeiro.</p>
    </div>

    <form asp-action="Login" method="post" class="auto-loader">
        @Html.AntiForgeryToken()
        <input asp-for="ReturnUrl" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                <input asp-for="Email" class="form-control" placeholder="voce@empresa.com" autocomplete="username" />
            </div>
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <div class="d-flex justify-content-between">
                <label asp-for="Password" class="form-label"></label>
                <a asp-action="ForgotPassword" style="font-size:12px">Esqueceu a senha?</a>
            </div>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                <input asp-for="Password" class="form-control" placeholder="Sua senha" autocomplete="current-password" />
            </div>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-check mb-4">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label"></label>
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2">
            <i class="bi bi-box-arrow-in-right"></i> Entrar na plataforma
        </button>
    </form>

    <div class="auth-divider my-4">Acesso rápido</div>
    <div class="alert alert-info py-3" style="background:var(--info-soft);border-color:var(--border);color:var(--text);font-size:12px">
        <div class="d-flex gap-2 align-items-start">
            <i class="bi bi-info-circle-fill text-info mt-1"></i>
            <div>
                <strong>Conta de demonstração</strong><br />
                E-mail: <code>demo@fintrack.app</code> · Senha: <code>Demo@1234</code><br />
                <span class="text-muted-2">Todos os dados financeiros são fictícios e identificados na interface.</span>
            </div>
        </div>
    </div>

    <p class="text-center mt-4 mb-0" style="font-size:12px">
        Ainda não tem uma conta? <a asp-action="Register"><strong>Criar conta gratuita</strong></a>
    </p>
</div>
