@{
    ViewData["Title"] = "Algo deu errado";
    var code = ViewData["StatusCode"]?.ToString() ?? "500";
}
<div class="card">
    <div class="card-body text-center py-5">
        <div style="font-size:64px;font-weight:800;color:var(--accent);letter-spacing:-.06em">@code</div>
        <h3 class="mt-2">@(code == "404" ? "Página não encontrada" : "Não foi possível concluir a operação")</h3>
        <p class="text-muted" style="max-width:420px;margin:10px auto 22px">
            @(code == "404" ? "O endereço acessado não existe ou foi movido." : "Ocorreu um erro inesperado. Tente novamente em instantes.")
        </p>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary"><i class="bi bi-house"></i> Voltar ao início</a>
    </div>
</div>
