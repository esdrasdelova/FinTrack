@model SettingsViewModel
@{
    ViewData["Title"] = "Configurações";
    var initials = string.Concat(Model.Profile.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpper(w[0])));
}

<div class="page-heading fade-up">
    <div>
        <h1 class="page-title">Configurações</h1>
        <p class="page-subtitle">Gerencie seu perfil, preferências e segurança da conta.</p>
    </div>
</div>

<div class="grid-main-side">
    <div class="card fade-up">
        <div class="card-body">
            <div class="d-flex align-items-center gap-3">
                @if (!string.IsNullOrEmpty(Model.Profile.AvatarUrl))
                {
                    <img src="@Model.Profile.AvatarUrl" alt="Avatar" class="avatar" style="width:64px;height:64px;font-size:20px" />
                }
                else
                {
                    <div class="avatar" style="width:64px;height:64px;font-size:20px">@initials</div>
                }
                <div>
                    <h4 class="mb-1" style="font-size:18px">@Model.Profile.FullName</h4>
                    <div class="text-muted" style="font-size:13px">@Model.Profile.Email</div>
                    <div class="entity-sub">Membro desde @Model.MemberSince @if (Model.IsDemo) { <span class="badge-soft badge-warning ms-1">Conta de demonstração</span> }</div>
                </div>
            </div>
            <div class="divider"></div>
            <div class="row g-2 text-center">
                @foreach (var counter in Model.Counters)
                {
                    <div class="col-4">
                        <div class="metric-value mb-0" style="font-size:18px">@counter.Value</div>
                        <div class="metric-label">@counter.Key</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="card fade-up">
        <div class="card-header"><div><h3 class="card-title"><i class="bi bi-shield-check"></i> Segurança</h3><div class="card-subtitle">Mantenha sua conta protegida</div></div></div>
        <div class="card-body">
            <div class="list-row"><div class="entity-icon bg-success-soft"><i class="bi bi-check2-circle"></i></div><div class="list-row-main"><div class="list-row-title">Autenticação ativa</div><div class="list-row-sub">Senha e sessão protegidas por Identity</div></div></div>
            <div class="list-row"><div class="entity-icon bg-accent-soft"><i class="bi bi-shield-lock"></i></div><div class="list-row-main"><div class="list-row-title">Isolamento de dados</div><div class="list-row-sub">Cada usuário acessa apenas seus próprios registros</div></div></div>
            <div class="list-row"><div class="entity-icon bg-info-soft"><i class="bi bi-file-earmark-lock"></i></div><div class="list-row-main"><div class="list-row-title">Proteção CSRF</div><div class="list-row-sub">Formulários e requisições validados por token</div></div></div>
        </div>
    </div>
</div>

<div class="card fade-up mt-3">
    <ul class="nav nav-tabs" id="settingsTabs" role="tablist">
        <li class="nav-item" role="presentation"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabProfile" type="button"><i class="bi bi-person"></i> Perfil</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabPreferences" type="button"><i class="bi bi-sliders"></i> Preferências</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabSecurity" type="button"><i class="bi bi-lock"></i> Alterar senha</button></li>
    </ul>
    <div class="card-body tab-content">
        <div class="tab-pane fade show active" id="tabProfile">
            <form id="profileForm" asp-action="SaveProfile" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div id="profileErrors"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Profile.FullName" class="form-label">Nome completo</label>
                        <input asp-for="Profile.FullName" class="form-control" />
                        <span asp-validation-for="Profile.FullName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Profile.Email" class="form-label">E-mail</label>
                        <input asp-for="Profile.Email" class="form-control" type="email" />
                        <span asp-validation-for="Profile.Email" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Profile.AvatarUrl" class="form-label">URL do avatar (opcional)</label>
                        <input asp-for="Profile.AvatarUrl" class="form-control" placeholder="https://..." />
                    </div>
                </div>
                <div class="mt-3"><button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Salvar perfil</button></div>
            </form>
        </div>

        <div class="tab-pane fade" id="tabPreferences">
            <form id="preferencesForm" asp-action="SaveProfile" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div id="preferencesErrors"></div>
                <input asp-for="Profile.FullName" type="hidden" />
                <input asp-for="Profile.Email" type="hidden" />
                <input asp-for="Profile.AvatarUrl" type="hidden" />
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="Profile.Theme" class="form-label">Tema da interface</label>
                        <select asp-for="Profile.Theme" class="form-select">
                            <option value="dark">Escuro (padrão)</option>
                            <option value="light">Claro</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Profile.Currency" class="form-label">Moeda</label>
                        <select asp-for="Profile.Currency" class="form-select">
                            <option value="BRL">BRL — Real</option>
                            <option value="USD">USD — Dólar</option>
                            <option value="EUR">EUR — Euro</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Profile.DateFormat" class="form-label">Formato de data</label>
                        <select asp-for="Profile.DateFormat" class="form-select">
                            <option value="dd/MM/yyyy">DD/MM/AAAA</option>
                            <option value="MM/dd/yyyy">MM/DD/AAAA</option>
                            <option value="yyyy-MM-dd">AAAA-MM-DD</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <div class="divider"></div>
                        <h6 class="mb-3">Notificações</h6>
                        <div class="row g-3">
                            <div class="col-md-6"><div class="form-check form-switch"><input asp-for="Profile.InAppNotifications" class="form-check-input" type="checkbox" /><label asp-for="Profile.InAppNotifications" class="form-check-label">Alertas na aplicação</label></div></div>
                            <div class="col-md-6"><div class="form-check form-switch"><input asp-for="Profile.EmailNotifications" class="form-check-input" type="checkbox" /><label asp-for="Profile.EmailNotifications" class="form-check-label">Notificações por e-mail</label></div></div>
                            <div class="col-md-6"><div class="form-check form-switch"><input asp-for="Profile.WeeklySummary" class="form-check-input" type="checkbox" /><label asp-for="Profile.WeeklySummary" class="form-check-label">Resumo semanal</label></div></div>
                            <div class="col-md-6"><div class="form-check form-switch"><input asp-for="Profile.SecurityAlerts" class="form-check-input" type="checkbox" /><label asp-for="Profile.SecurityAlerts" class="form-check-label">Alertas de segurança</label></div></div>
                        </div>
                    </div>
                </div>
                <div class="mt-3"><button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Salvar preferências</button></div>
            </form>
        </div>

        <div class="tab-pane fade" id="tabSecurity">
            <form id="passwordForm" asp-action="ChangePassword" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div id="passwordErrors"></div>
                <div class="row g-3" style="max-width:520px">
                    <div class="col-12"><label asp-for="Password.CurrentPassword" class="form-label">Senha atual</label><input asp-for="Password.CurrentPassword" class="form-control" type="password" /><span asp-validation-for="Password.CurrentPassword" class="text-danger"></span></div>
                    <div class="col-12"><label asp-for="Password.NewPassword" class="form-label">Nova senha</label><input asp-for="Password.NewPassword" class="form-control" type="password" /><span asp-validation-for="Password.NewPassword" class="text-danger"></span></div>
                    <div class="col-12"><label asp-for="Password.ConfirmPassword" class="form-label">Confirmar nova senha</label><input asp-for="Password.ConfirmPassword" class="form-control" type="password" /><span asp-validation-for="Password.ConfirmPassword" class="text-danger"></span></div>
                </div>
                <div class="mt-3"><button type="submit" class="btn btn-primary"><i class="bi bi-key"></i> Alterar senha</button></div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            async function submitForm(id, errorId, themeToApply) {
                const form = document.getElementById(id);
                if (!form) return;
                form.addEventListener('submit', async e => {
                    e.preventDefault();
                    FinTrack.loader(true);
                    try {
                        const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
                        const result = await res.json();
                        FinTrack.loader(false);
                        if (result.success) {
                            FinTrack.showToast(result.message, 'success');
                            if (themeToApply) {
                                const theme = new FormData(form).get('Profile.Theme');
                                localStorage.setItem('fintrack-theme', theme);
                                document.cookie = 'fintrack-theme=' + theme + ';path=/;max-age=' + (90 * 24 * 3600);
                            }
                            setTimeout(() => location.reload(), 600);
                        } else {
                            document.getElementById(errorId).innerHTML = (result.errors || [result.message]).map(m => `<div class="alert alert-danger py-2 small mb-1">${m}</div>`).join('');
                        }
                    } catch (err) { FinTrack.loader(false); FinTrack.showToast('Erro ao salvar.', 'error'); }
                });
            }
            submitForm('profileForm', 'profileErrors', false);
            submitForm('preferencesForm', 'preferencesErrors', true);
            submitForm('passwordForm', 'passwordErrors', false);
        });
    </script>
}
