@model GoalFormViewModel
@{
    var isEdit = Model.Id > 0;
    var colors = new[] { "#10b981", "#6366f1", "#8b5cf6", "#06b6d4", "#f59e0b", "#f43f5e", "#ec4899", "#14b8a6" };
    var icons = new[] { "bi-stars", "bi-house", "bi-car-front", "bi-mortarboard", "bi-plane", "bi-gift", "bi-umbrella", "bi-trophy" };
}
<div class="modal-header">
    <h5 class="modal-title"><i class="bi @(isEdit ? "bi-pencil-square" : "bi-plus-circle")"></i> @(isEdit ? "Editar meta" : "Nova meta")</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
</div>
<div class="modal-body">
    <div id="formErrors"></div>
    <form id="crudForm" asp-action="Save" method="post" novalidate>
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="Ex.: Reserva de emergência" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="2" placeholder="Descreva seu objetivo (opcional)"></textarea>
            </div>
            <div class="col-sm-6">
                <label asp-for="TargetAmount" class="form-label">Valor alvo (R$)</label>
                <input asp-for="TargetAmount" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="TargetAmount" class="text-danger"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="CurrentAmount" class="form-label">Valor atual (R$)</label>
                <input asp-for="CurrentAmount" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="CurrentAmount" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Deadline" class="form-label">Prazo</label>
                <input asp-for="Deadline" class="form-control" type="date" />
                <span asp-validation-for="Deadline" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label class="form-label">Cor</label>
                <div class="d-flex gap-2 flex-wrap">
                    @foreach (var color in colors)
                    {
                        <label class="color-choice" style="background:@color;@(Model.Color == color ? "outline:2px solid #fff;outline-offset:2px;" : "")">
                            <input type="radio" name="Color" value="@color" @(Model.Color == color ? "checked" : "") />
                        </label>
                    }
                </div>
            </div>
            <div class="col-12">
                <label class="form-label">Ícone</label>
                <div class="d-flex gap-2 flex-wrap">
                    @foreach (var icon in icons)
                    {
                        <label class="icon-choice @(Model.Icon == icon ? "selected" : "")">
                            <input type="radio" name="Icon" value="@icon" @(Model.Icon == icon ? "checked" : "") />
                            <i class="bi @icon"></i>
                        </label>
                    }
                </div>
            </div>
        </div>
    </form>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
    <button type="submit" form="crudForm" class="btn btn-primary"><i class="bi bi-check-lg"></i> @(isEdit ? "Salvar alterações" : "Criar meta")</button>
</div>
<style>
    .color-choice { width:30px;height:30px;border-radius:8px;cursor:pointer;display:inline-block; }
    .color-choice input { display:none; }
    .icon-choice { width:38px;height:38px;border-radius:9px;background:var(--surface-2);border:1px solid var(--border);display:grid;place-items:center;cursor:pointer;font-size:17px;color:var(--muted); }
    .icon-choice.selected { border-color:var(--accent);color:var(--accent);background:var(--accent-soft); }
    .icon-choice input { display:none; }
</style>
<script>
    document.querySelectorAll('.icon-choice input, .color-choice input').forEach(input => {
        input.addEventListener('change', () => {
            document.querySelectorAll('.icon-choice').forEach(el => el.classList.remove('selected'));
            input.closest('.icon-choice')?.classList.add('selected');
            document.querySelectorAll('.color-choice').forEach(el => el.style.outline = 'none');
            if (input.closest('.color-choice')) input.closest('.color-choice').style.outline = '2px solid #fff';
        });
    });
</script>
