@model InvestmentDetailsViewModel
@{
    ViewData["Title"] = Model.Investment.Name;
    var i = Model.Investment;
}

<div class="page-heading fade-up">
    <div>
        <h1 class="page-title">@i.Name @if (!string.IsNullOrEmpty(i.Ticker)) { <span class="badge-soft badge-accent">@i.Ticker</span> }</h1>
        <p class="page-subtitle">@FinTrackFormat.InvestmentName(i.Category)@(string.IsNullOrEmpty(i.Institution) ? "" : $" · {i.Institution}")</p>
    </div>
    <div class="page-actions">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Voltar</a>
        <button type="button" class="btn btn-primary" data-action="new-transaction"><i class="bi bi-plus-lg"></i> Nova movimentação</button>
    </div>
</div>

<div class="kpi-grid">
    @await Html.PartialAsync("_MetricCard", new MetricCardViewModel { Label = "Valor atual", Value = FinTrackFormat.Currency(i.CurrentValue), Icon = "bi-graph-up-arrow", Tone = "accent" })
    @await Html.PartialAsync("_MetricCard", new MetricCardViewModel { Label = "Investido", Value = FinTrackFormat.Currency(i.Invested), Icon = "bi-piggy-bank", Tone = "info", Footer = $"{i.Quantity.ToString(System.Globalization.CultureInfo.InvariantCulture)} unidade(s)" })
    @await Html.PartialAsync("_MetricCard", new MetricCardViewModel { Label = "Resultado", Value = FinTrackFormat.Currency(i.Profit), Icon = "bi-currency-exchange", Tone = i.Profit >= 0 ? "success" : "danger", TrendText = FinTrackFormat.Percent(i.ProfitPercentage), TrendDirection = i.Profit >= 0 ? "up" : "down" })
    @await Html.PartialAsync("_MetricCard", new MetricCardViewModel { Label = "Movimentações", Value = i.TransactionCount.ToString(), Icon = "bi-arrow-left-right", Tone = "warning" })
</div>

<div class="grid-main-side">
    <div class="card fade-up">
        <div class="card-header"><div><h3 class="card-title"><i class="bi bi-graph-up"></i> Histórico de movimentações</h3><div class="card-subtitle">Valores registrados ao longo do tempo</div></div></div>
        <div class="card-body">
            @if (Model.Transactions.Any())
            {
                <div class="chart-box"><div class="chart-skeleton"></div><canvas id="chartInvestmentDetail"></canvas></div>
            }
            else
            {
                @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel { Icon = "bi-graph-up", Title = "Sem movimentações" })
            }
        </div>
    </div>
    <div class="card fade-up">
        <div class="card-header"><div><h3 class="card-title"><i class="bi bi-info-circle"></i> Posição do ativo</h3></div></div>
        <div class="card-body">
            <div class="list-row"><div class="list-row-main"><div class="list-row-sub">Quantidade</div><div class="list-row-title">@i.Quantity.ToString(System.Globalization.CultureInfo.InvariantCulture)</div></div></div>
            <div class="list-row"><div class="list-row-main"><div class="list-row-sub">Preço médio</div><div class="list-row-title">@FinTrackFormat.Currency(i.AveragePrice)</div></div></div>
            <div class="list-row"><div class="list-row-main"><div class="list-row-sub">Preço atual (informado)</div><div class="list-row-title">@FinTrackFormat.Currency(i.CurrentPrice)</div></div></div>
            <div class="list-row"><div class="list-row-main"><div class="list-row-sub">Classe</div><div class="list-row-title">@FinTrackFormat.InvestmentName(i.Category)</div></div></div>
            <div class="list-row"><div class="list-row-main"><div class="list-row-sub">Instituição</div><div class="list-row-title">@(string.IsNullOrEmpty(i.Institution) ? "—" : i.Institution)</div></div></div>
        </div>
    </div>
</div>

<div class="card fade-up">
    <div class="card-header"><div><h3 class="card-title"><i class="bi bi-list-ul"></i> Movimentações</h3><div class="card-subtitle">Compras, vendas e proventos registrados</div></div></div>
    <div class="card-body tight">
        @if (Model.Transactions.Any())
        {
            <div class="table-wrap"><table class="data-table">
                <thead><tr><th>Data</th><th>Tipo</th><th>Quantidade</th><th>Preço</th><th class="text-end">Valor</th><th>Observação</th><th style="width:50px"></th></tr></thead>
                <tbody>
                    @foreach (var t in Model.Transactions)
                    {
                        <tr>
                            <td class="text-muted">@FinTrackFormat.Date(t.Date)</td>
                            <td><span class="badge-soft badge-@(t.Type == InvestmentTransactionType.Buy ? "success" : t.Type == InvestmentTransactionType.Sell ? "danger" : "accent")">@(t.Type == InvestmentTransactionType.Buy ? "Compra" : t.Type == InvestmentTransactionType.Sell ? "Venda" : t.Type == InvestmentTransactionType.Dividend ? "Provento" : "Aporte")</span></td>
                            <td class="text-muted">@t.Quantity.ToString(System.Globalization.CultureInfo.InvariantCulture)</td>
                            <td class="text-muted">@FinTrackFormat.Currency(t.Price)</td>
                            <td class="text-end">@FinTrackFormat.Currency(t.Amount)</td>
                            <td class="text-muted">@(string.IsNullOrEmpty(t.Notes) ? "—" : t.Notes)</td>
                            <td><button type="button" class="btn btn-sm btn-light btn-icon text-danger" title="Remover movimentação" data-action="delete-transaction" data-id="@t.Id"><i class="bi bi-trash3"></i></button></td>
                        </tr>
                    }
                </tbody>
            </table></div>
        }
        else
        {
            @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel { Icon = "bi-inbox", Title = "Nenhuma movimentação registrada" })
        }
    </div>
</div>

<div class="modal fade" id="txModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content" id="txContainer"></div></div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            @if (Model.Transactions.Any()) { <text>FinTrackCharts.render('chartInvestmentDetail', @Html.Raw(Model.EvolutionChartJson));</text> }
            const modal = new bootstrap.Modal(document.getElementById('txModal'));
            const container = document.getElementById('txContainer');
            document.querySelectorAll('[data-action="new-transaction"]').forEach(el => el.addEventListener('click', () => {
                container.innerHTML = '<div class="modal-body text-center py-4"><div class="spinner mx-auto"></div></div>';
                modal.show();
                fetch('@Url.Action("TransactionForm")?investmentId=@i.Id', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(r => r.text()).then(html => {
                        container.innerHTML = html;
                        container.querySelector('#txForm')?.addEventListener('submit', async e => {
                            e.preventDefault();
                            FinTrack.loader(true);
                            const res = await fetch('@Url.Action("AddTransaction")', { method: 'POST', body: new FormData(e.target) });
                            const result = await res.json();
                            FinTrack.loader(false);
                            if (result.success) { modal.hide(); FinTrack.showToast(result.message, 'success'); setTimeout(() => location.reload(), 600); }
                            else { container.querySelector('#formErrors').innerHTML = (result.errors || [result.message]).map(m => `<div class="alert alert-danger py-2 small mb-1">${m}</div>`).join(''); }
                        });
                    });
            }));
            document.querySelectorAll('[data-action="delete-transaction"]').forEach(el => el.addEventListener('click', async () => {
                const r = await Swal.fire({ title: 'Remover movimentação?', text: 'A quantidade e o preço médio serão recalculados automaticamente.', icon: 'warning', showCancelButton: true, confirmButtonText: 'Sim, remover', cancelButtonText: 'Cancelar', confirmButtonColor: '#f43f5e', cancelButtonColor: '#64748b' });
                if (!r.isConfirmed) return;
                FinTrack.loader(true);
                const res = await fetch('@Url.Action("DeleteTransaction")', { method: 'POST', headers: { 'RequestVerificationToken': FinTrack.csrfToken() }, body: new URLSearchParams({ id: el.dataset.id }) });
                const result = await res.json();
                FinTrack.loader(false);
                FinTrack.showToast(result.message, result.success ? 'success' : 'error');
                if (result.success) setTimeout(() => location.reload(), 600);
            }));
        });
    </script>
}
