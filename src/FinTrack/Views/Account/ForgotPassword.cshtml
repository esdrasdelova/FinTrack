@model ForgotPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Recuperar senha";
}
<div class="auth-form fade-up">
    <div class="mb-4">
        <div class="metric-icon bg-accent-soft mb-3"><i class="bi bi-key"></i></div>
        <h2>Recuperar acesso</h2>
        <p class="text-muted" style="font-size:13px">Informe seu e-mail para gerar um link de redefinição de senha.</p>
    </div>

    <form asp-action="ForgotPassword" method="post" class="auto-loader">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
        <div class="mb-4">
            <label asp-for="Email" class="form-label"></label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                <input asp-for="Email" class="form-control" placeholder="voce@empresa.com" />
            </div>
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100 py-2"><i class="bi bi-send"></i> Gerar link de recuperação</button>
    </form>

    @if (ViewBag.ResetLink != null)
    {
        <div class="alert mt-4" style="background:var(--success-soft);border-color:var(--border);color:var(--text);font-size:12px">
            <strong><i class="bi bi-check-circle"></i> Link gerado.</strong>
            <p class="mb-2 mt-1">Como o envio de e-mail não está configurado neste ambiente, copie o link abaixo:</p>
            <a href="@ViewBag.ResetLink" style="word-break:break-all">@ViewBag.ResetLink</a>
        </div>
    }

    <p class="text-center mt-4 mb-0" style="font-size:12px"><a asp-action="Login"><i class="bi bi-arrow-left"></i> Voltar para o login</a></p>
</div>
